# Copy this file to env/local.env (same folder) and adjust values.
# env/local.env is git-ignored, so your keys never reach GitHub.

PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/agentreplay
CLIENT_ORIGIN=http://localhost:5173

# Use a long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Demo mode turns on the "Try the demo" sign-in. Set to false for a real deployment.
DEMO_MODE=true
