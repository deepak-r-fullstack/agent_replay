# Copy this file to env/local.env (same folder) and adjust values.
# env/local.env is git-ignored, so your keys never reach GitHub.

PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/agentreplay
CLIENT_ORIGIN=http://localhost:5173

# Use a long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Demo mode turns on the "Try the demo" sign-in. Set to false for a real deployment.
DEMO_MODE=true
# While demo mode is on, the shared demo starts again from its refund story once an hour. Leave this as true.
DEMO_AUTO_RESET=true
# Where AgentGuard's public demo lives. The wrong refund in the demo links to the matching action there.
AGENTGUARD_DEMO_URL=https://agentguard.sritaraksolutions.in

# Forks re-run AI steps through one model. "demo" is a free scripted model that needs no key (good for trying the app).
# LLM_PROVIDER: demo | openai | anthropic | ollama
LLM_PROVIDER=demo
LLM_MODEL=
# The only models a fork may ask for, comma-separated (for example: gpt-4.1-mini,gpt-4o-mini). A model that is not on
# the list is replaced by LLM_MODEL, so nobody can pick an expensive one. Leave empty to allow only LLM_MODEL.
LLM_ALLOWED_MODELS=
# What your AI provider charges, in US dollars per million tokens, so forks and tests can show what they cost.
# Leave at 0 if you do not know: costs then show as a dash.
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
LLM_API_KEY=
# Only for ollama (local: http://127.0.0.1:11434) or an OpenAI-compatible gateway.
LLM_BASE_URL=
